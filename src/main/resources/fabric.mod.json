{
  "schemaVersion": 1,
  "id": "wimpyclient",
  "version": "1.0.18",
  "name": "WimpyClient",
  "description": "Client utility that marks chunks with high activity at Y\u003d30.",
  "authors": [
    "Zylexz"
  ],
  "license": "All Rights Reserved",
  "icon": "assets/wimpyclient/icon.png",
